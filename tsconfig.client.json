{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/client/**/*.ts", "src/client/**/*.tsx"]
}
